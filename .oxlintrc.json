{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "import", "unicorn", "vitest"],
  "jsPlugins": [
    {
      "name": "effect",
      "specifier": "@mpsuesser/oxlint-plugin-effect"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "effect/avoid-direct-json": "error",
    "effect/avoid-native-fetch": "error",
    "effect/avoid-native-object-helpers": "error",
    "effect/avoid-node-imports": "error",
    "effect/avoid-non-null-assertion": "error",
    "effect/avoid-option-getorthrow": "error",
    "effect/avoid-platform-coupling": "error",
    "effect/avoid-process-env": "error",
    "effect/avoid-schema-suffix": "error",
    "effect/avoid-sync-fs": "error",
    "effect/avoid-ts-ignore": "error",
    "effect/avoid-yield-ref": "error",
    "effect/context-tag-extends": "error",
    "effect/effect-promise-vs-trypromise": "error",
    "effect/imperative-loops": "error",
    "effect/no-barrel-imports": "error",
    "effect/no-effect-ignore-then-as": "error",
    "effect/prefer-arr-match": "error",
    "effect/prefer-arr-sort": "error",
    "effect/prefer-duration-constructors": "error",
    "effect/prefer-match-over-switch": "error",
    "effect/prefer-namespace-imports": "error",
    "effect/prefer-redacted-config": "error",
    "effect/require-effect-concurrency": "error",
    "effect/require-filter-metadata": "error",
    "effect/require-schema-type-alias": "error",
    "effect/throw-in-effect-gen": "error",
    "effect/use-clock-service": "error",
    "effect/use-command-executor-service": "error",
    "effect/use-console-service": "error",
    "effect/use-filesystem-service": "error",
    "effect/use-http-client-service": "error",
    "effect/use-path-service": "error",
    "effect/use-random-service": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-extra-non-null-assertion": "error",
    "typescript/no-non-null-assertion": "error"
  },
  "ignorePatterns": ["node_modules/**", "dist/**", "coverage/**"]
}
