{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "@mpsuesser/project-cli",
  "version": "0.0.0",
  "description": "An Effect-powered project CLI",
  "license": "MIT",
  "author": "Marc Suesser",
  "type": "module",
  "bin": {
    "project": "dist/main.js"
  },
  "files": [
    "dist/main.js",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mpsuesser/project.git"
  },
  "bugs": {
    "url": "https://github.com/mpsuesser/project/issues"
  },
  "homepage": "https://github.com/mpsuesser/project#readme",
  "keywords": [
    "bun",
    "cli",
    "effect",
    "project"
  ],
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "build": "bun build src/main.ts --target=bun --packages=external --outdir=dist",
    "build:binary": "bun build src/main.ts --compile --outfile=dist/project",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives .",
    "test": "vitest run",
    "check": "bun run format:check && bun run typecheck && bun run lint && bun run test && bun run build",
    "lefthook:install": "lefthook install",
    "prepack": "bun run build",
    "prepare": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then bun run lefthook:install; fi"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-rc.109",
    "effect": "4.0.0-rc.109"
  },
  "devDependencies": {
    "@effect/language-service": "0.87.2",
    "@effect/vitest": "4.0.0-rc.109",
    "@mpsuesser/oxlint-plugin-effect": "0.4.3",
    "@oxlint/plugins": "1.78.0",
    "@types/bun": "1.3.14",
    "dprint": "0.55.2",
    "lefthook": "2.1.10",
    "oxlint": "1.78.0",
    "typescript": "7.0.1-rc",
    "vitest": "4.1.10"
  },
  "trustedDependencies": [
    "dprint",
    "lefthook"
  ]
}
